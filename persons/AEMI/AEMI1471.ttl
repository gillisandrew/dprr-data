<http://romanrepublic.ac.uk/rdf/entity/PersonNote/173> rdfs:label "Person Note: #173" ;
	a dprr:PersonNote ;
	dprr:hasSecondarySourceForNote <http://romanrepublic.ac.uk/rdf/entity/SecondarySource/28> ;
	dprr:hasNoteType <http://romanrepublic.ac.uk/rdf/entity/NoteType/11> ;
	dprr:hasNoteText "Ob er zu den beiden Decemviri gehörte, die zu Claudius in unbekannter Funktion nach Norditalien geschickte wurden, ist ungewiß." .
