	dprr:hasProvinceOriginal "Rome" ;
	dprr:hasPostAssertionNote <http://romanrepublic.ac.uk/rdf/entity/PostAssertionNote/9553> ;
	dprr:hasPosition 0 ;
	dprr:hasOriginalText "Claudius Pulcher, Appius" ;
	dprr:hasOffice <http://romanrepublic.ac.uk/rdf/entity/Office/155> ;
	dprr:hasDateStart -110 ;
	dprr:hasDateSourceText "111 - 110" ;
	dprr:hasDateSecondarySource <http://romanrepublic.ac.uk/rdf/entity/SecondarySource/10> ;
	dprr:hasDateEnd -110 .
