	dprr:hasNoteType <http://romanrepublic.ac.uk/rdf/entity/NoteType/1> ;
	dprr:hasNoteText "Cos. 128, Or[150] Cn. Octavius Cn. f. Cn. n. (20). Cos. 87. Badian (Studies 104, note 168) notes that the inscription of Delos (I. De Delos 1782; see MRR 2.26) may well refer to the future consul of 128.\r\n" .
<http://romanrepublic.ac.uk/rdf/entity/PostAssertionNote/3216> rdfs:label "Post Assertion Note: #3216" ;
	a dprr:PostAssertionNote ;
	dprr:hasSecondarySourceForNote <http://romanrepublic.ac.uk/rdf/entity/SecondarySource/1> ;
	dprr:hasNoteType <http://romanrepublic.ac.uk/rdf/entity/NoteType/1> ;
	dprr:hasNoteText "Chr. 354 (Optavio et Rufo); Fast. Hyd. (Octavio et Rufo), so also Chr. Pasc.; Cassiod.; see Degrassi 126, 470f." .
<http://romanrepublic.ac.uk/rdf/entity/PostAssertionNote/3189> rdfs:label "Post Assertion Note: #3189" ;
	a dprr:PostAssertionNote ;
